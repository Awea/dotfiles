#!/usr/bin/env bash

# Free disk space when the root disk is low.
#
#   Usage: prune-disk [--force]
#
# Does nothing while / has MIN_FREE_GB or more free (default: 100). Below that,
# it removes:
#   - Nix generations older than 14 days, then all unused store paths
#   - Docker images, containers and build cache unused for 7 days
#   - anonymous Docker volumes that no container uses (named volumes stay)
#   - files in ~/.cache and ~/.npm not read for 30 days
#
# --force runs the cleanup whatever the free space is.
# A systemd user timer runs this script every day, see config/nix/home.nix.

set -euo pipefail

min_free_gb="${MIN_FREE_GB:-100}"
export PATH="/nix/var/nix/profiles/default/bin:$HOME/.nix-profile/bin:/usr/bin:/bin:$PATH"

free_gb() { df --output=avail -B1G / | tail -1 | tr -d ' '; }

before=$(free_gb)
if [[ "${1:-}" != "--force" && "$before" -ge "$min_free_gb" ]]; then
  echo "${before}G free on /, threshold is ${min_free_gb}G: nothing to do"
  exit 0
fi

echo "${before}G free on /, threshold is ${min_free_gb}G: pruning"

echo "==> nix"
nix-collect-garbage --delete-older-than 14d || echo "nix gc failed"

if command -v docker >/dev/null && docker info >/dev/null 2>&1; then
  echo "==> docker"
  docker system prune --all --force --filter until=168h || echo "docker system prune failed"
  docker volume prune --force || echo "docker volume prune failed"
fi

echo "==> caches"
for dir in "$HOME/.cache" "$HOME/.npm/_cacache"; do
  [[ -d "$dir" ]] || continue
  find "$dir" -xdev -type f -atime +30 -delete 2>/dev/null || true
  find "$dir" -xdev -mindepth 1 -type d -empty -delete 2>/dev/null || true
done

after=$(free_gb)
message="Freed $((after - before))G, ${after}G free on /"
echo "$message"
if [[ "$after" -lt "$min_free_gb" ]] && command -v notify-send >/dev/null; then
  notify-send --urgency=critical "prune-disk" "$message. Still under ${min_free_gb}G, run ncdu -x / to find the rest."
fi
