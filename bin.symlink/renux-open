#!/usr/bin/env bash

# Open a file from the Renux file peek: a markdown file rendered in Leaf, another file
# in Fresh at its line.
#
#   Usage: renux-open view LINE PATH   the editor-command of Renux (renux/look.sh)
#
# In Leaf: a drag selects text and copies it without the wrap, @ asks an agent pane
# about the selection, f finds text, ? shows the keys, q quits. Config in config/leaf.
# Exit 2: a usage error. LEAF_BIN and FRESH_BIN are the commands (default leaf and fresh).

set -euo pipefail

usage() {
  echo "usage: renux-open view LINE PATH" >&2
  exit 2
}

if [ "${1:-}" != view ] || [ $# -ne 3 ]; then
  usage
fi
line=$2 path=$3
shopt -s nocasematch
case "$path" in
  *.md | *.markdown) exec "${LEAF_BIN:-leaf}" open "$path" ;;
esac
exec "${FRESH_BIN:-fresh}" "$path:$line"
