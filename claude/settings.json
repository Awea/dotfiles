{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "FORCE_HYPERLINK": "1"
  },
  "model": "opus",
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/skills/ste-writing/hooks/ste-gate.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/skills/ste-writing/hooks/ste-inject.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/herdr-agent-name.sh start",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "obsidian-second-brain@obsidian-second-brain": true,
    "superpowers@claude-plugins-official": true,
    "pg@aiguide": true
  },
  "extraKnownMarketplaces": {
    "obsidian-second-brain": {
      "source": {
        "source": "github",
        "repo": "eugeniughelbur/obsidian-second-brain"
      }
    },
    "aiguide": {
      "source": {
        "source": "github",
        "repo": "timescale/pg-aiguide"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "preferredNotifChannel": "notifications_disabled",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false
}
