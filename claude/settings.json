{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "FORCE_HYPERLINK": "1",
    "MCP_TIMEOUT": "60000",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "model": "opus",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/skills/ste-writing/hooks/ste-gate.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/skills/ste-writing/hooks/ste-inject.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/skills/ste-writing/hooks/ste-inject.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/skills/board-orchestrator/hooks/compact.sh\"; [ -f \"$f\" ] || exit 0; bash \"$f\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/skills/board-orchestrator/hooks/guard.sh\"; [ -f \"$f\" ] || exit 0; bash \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "obsidian-second-brain@obsidian-second-brain": true,
    "superpowers@claude-plugins-official": true,
    "pg@aiguide": false
  },
  "extraKnownMarketplaces": {
    "obsidian-second-brain": {
      "source": {
        "source": "github",
        "repo": "eugeniughelbur/obsidian-second-brain"
      }
    },
    "aiguide": {
      "source": {
        "source": "github",
        "repo": "timescale/pg-aiguide"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "enableArtifact": false,
  "preferredNotifChannel": "notifications_disabled",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false,
  "enableWorkflows": false,
  "bashOutputMaxChars": 10000,
  "permissions": {
    "deny": [
      "SendFeedback",
      "ReportFindings"
    ]
  },
  "skillOverrides": {
    "anthropic-skills:built-in-browser": "user-invocable-only",
    "anthropic-skills:chrome-browser": "user-invocable-only",
    "anthropic-skills:computer-use": "user-invocable-only",
