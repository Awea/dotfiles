#!/usr/bin/env bash
# A fake hc for the bats tests. It logs each call to $FAKE_LOG and answers from files
# in $FAKE_DIR: hc-get-<addr>.json, hc-ls.json, hc-wait.json, hc-read.txt,
# hc-templates.json. FAKE_HC_FAIL=1 makes every call fail, FAKE_SEND_FAIL=1 each send.
printf 'hc %s\n' "$*" >>"$FAKE_LOG"
[ "${FAKE_HC_FAIL:-}" != 1 ] || { printf 'hc: the core does not answer\n' >&2; exit 1; }
cmd=${1:-}
shift || true
case "$cmd" in
  get)
    f="$FAKE_DIR/hc-get-$1.json"
    if [ -f "$f" ]; then cat "$f"; else
      printf '{"error":{"kind":"not_found","message":"no terminal \\"%s\\""}}\n' "$1"
      exit 3
    fi
    ;;
  ls) cat "$FAKE_DIR/hc-ls.json" 2>/dev/null || printf '{"terminals":[]}\n' ;;
  run)
    # The exact arguments, NUL-separated, for the tests: one file per call.
    n=$(find "$FAKE_DIR" -name 'hc-run-*.args' | wc -l | tr -d ' ')
    printf '%s\0' "$@" >"$FAKE_DIR/hc-run-$((n + 1)).args"
    printf '{"address":"%s","state":"live"}\n' "${FAKE_RUN_ADDR:-t9}"
    ;;
  wait)
    [ -z "${FAKE_WAIT_SLEEP:-}" ] || sleep "$FAKE_WAIT_SLEEP"
    # A test hook: on-wait runs at each wait (it can change the state of a terminal).
    [ ! -x "$FAKE_DIR/on-wait" ] || "$FAKE_DIR/on-wait" "$@"
    cat "$FAKE_DIR/hc-wait.json" 2>/dev/null || printf '{"ended":true,"reason":"status","status":"idle"}\n'
    ;;
  send)
    [ "${FAKE_SEND_FAIL:-}" != 1 ] || { printf 'hc: send failed\n' >&2; exit 1; }
    # A test hook: on-send gets the arguments of hc send (it can write a file).
    [ ! -x "$FAKE_DIR/on-send" ] || "$FAKE_DIR/on-send" "$@"
    # send --wait answers as wait does.
    case " $* " in *" --wait "*)
      [ -z "${FAKE_WAIT_SLEEP:-}" ] || sleep "$FAKE_WAIT_SLEEP"
      cat "$FAKE_DIR/hc-wait.json" 2>/dev/null || printf '{"ended":true,"reason":"status","status":"idle"}\n'
      ;;
    esac
    ;;
  read) cat "$FAKE_DIR/hc-read.txt" 2>/dev/null || true ;;
  templates) cat "$FAKE_DIR/hc-templates.json" 2>/dev/null || printf '{"templates":[]}\n' ;;
  *) : ;;
esac
