#!/usr/bin/env bash
# A fake herdr-app for the bats tests. It logs each call to $FAKE_LOG. `do` answers
# $FAKE_DIR/app-do.json, else {"ok":true}.
printf 'herdr-app %s\n' "$*" >>"$FAKE_LOG"
[ "${FAKE_APP_FAIL:-}" != 1 ] || { printf 'herdr-app: no window\n' >&2; exit 1; }
case "${1:-}" in
  do)
    # The exact arguments, NUL-separated, for the tests: one file per call.
    n=$(find "$FAKE_DIR" -name 'app-do-*.args' | wc -l | tr -d ' ')
    printf '%s\0' "$@" >"$FAKE_DIR/app-do-$((n + 1)).args"
    cat "$FAKE_DIR/app-do.json" 2>/dev/null || printf '{"ok":true}\n'
    ;;
  ls) cat "$FAKE_DIR/app-ls.json" 2>/dev/null || printf '{"spaces":[]}\n' ;;
  *) : ;;
esac
