#!/usr/bin/env bash
# The herdr CLI of Herdr 0.9.5, for herdr-reviewr in Rex: the 7 calls that
# herdr-reviewr 0.37.1 makes (src/herdr.rs), answered from Rex. reviewr.sh sets
# HERDR_BIN_PATH to this file. A Herdr workspace is a Rex session, a tab is a Rex window,
# a pane is a Rex block.
#
# pane send-text presses Enter: reviewr's Send submits the comments at once.
set -euo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
here=$(dirname "$(readlink -f "$0")")

api() { rex api call "$1" "$2"; }

# session_blocks SESSION: one JSON line for each terminal block of SESSION.
session_blocks() {
  api session.list_blocks "$(jq -cn --arg s "$1" '{session_id: $s}')" |
    jq -c --arg s "$1" '.blocks[] | select(.creator_name == "com.superlogical.terminal")
      | {session_id: $s, block_id, window_id, label: .label}'
}

# blocks: one JSON line for each terminal block of each session, with its session.
blocks() {
  local session
  for session in $(api session.list '{}' | jq -r '.sessions[].session_id'); do
    session_blocks "$session"
  done
}

# method SESSION BLOCK METHOD: the JSON of a terminal method of BLOCK.
method() {
  api block.method "$(jq -cn --arg s "$1" --arg b "$2" --arg m "$3" \
    '{session_id: $s, block_id: $b, method: $m}')" 2>/dev/null || echo '{}'
}

# session_of BLOCK: the session that holds BLOCK. The session of reviewr
# (HERDR_WORKSPACE_ID) first: one call, where the scan of each session takes one call
# for each session.
session_of() {
  if [ -n "${HERDR_WORKSPACE_ID:-}" ] &&
    api session.list_blocks "$(jq -cn --arg s "$HERDR_WORKSPACE_ID" '{session_id: $s}')" 2>/dev/null |
    jq -e --arg b "$1" 'any(.blocks[]?; .block_id == $b)' >/dev/null 2>&1; then
    printf '%s\n' "$HERDR_WORKSPACE_ID"
    return
  fi
  blocks | jq -r --arg b "$1" 'select(.block_id == $b) | .session_id' | head -1
}

# agent_of BLOCK_JSON: the agent entry of the block, with the fields of `herdr agent
# list`. Nothing when its program reports no agent status.
agent_of() {
  local s id status cwd
  IFS=$'\t' read -r s id < <(jq -r '[.session_id, .block_id] | @tsv' <<<"$1")
  status=$(method "$s" "$id" program_status | jq -c '[.records[]? | select(.app != null)][0] // empty')
  [ -n "$status" ] || return 0
  cwd=$(method "$s" "$id" process | jq -r '.foreground.cwd // .child.cwd // ""')
  jq -cn --argjson b "$1" --argjson st "$status" --arg cwd "$cwd" '{
    agent: (if $st.app == "claude-code" then "claude" else $st.app end),
    agent_status: $st.state, pane_id: $b.block_id, tab_id: $b.window_id,
    workspace_id: $b.session_id, cwd: $cwd, name: $b.label}'
}

# agents_of: the agent entries of the blocks on stdin, in their order. The blocks run in
# parallel: Send waits for this call, and each block takes two rex calls.
agents_of() {
  local dir b i=0 j
  dir=$(mktemp -d "${TMPDIR:-/tmp}/herdr-shim.XXXXXX")
  # agents_of runs in a subshell: the trap also removes the folder when reviewr quits.
  trap 'rm -rf "$dir"' EXIT
  while IFS= read -r b; do
    agent_of "$b" >"$dir/$i" &
    i=$((i + 1))
  done
  wait
  for ((j = 0; j < i; j++)); do cat "$dir/$j"; done
}

# agents: {"result":{"agents":[...]}}, one entry for each block whose program reports an
# agent status. When the tab of reviewr (HERDR_TAB_ID) has an agent, only the agents of
# that tab: reviewr sends to a sole agent at once. That tab is read first, from the
# session of reviewr: the scan of each block of each session takes seconds.
agents() {
  local here=""
  if [ -n "${HERDR_WORKSPACE_ID:-}" ] && [ -n "${HERDR_TAB_ID:-}" ]; then
    here=$(session_blocks "$HERDR_WORKSPACE_ID" 2>/dev/null |
      jq -c --arg t "$HERDR_TAB_ID" 'select(.window_id == $t)' | agents_of) || here=""
  fi
  if [ -n "$here" ]; then
    printf '%s\n' "$here" | jq -sc '{result: {agents: .}}'
    return
  fi
  blocks | agents_of | jq -sc --arg tab "${HERDR_TAB_ID:-}" '
    [.[] | select(.tab_id == $tab and $tab != "")] as $here
    | {result: {agents: (if $here == [] then . else $here end)}}'
}

# unpaste TEXT: TEXT without the bracketed paste markers that reviewr adds.
unpaste() {
  local text=$1
  text=${text#$'\e[200~'}
  text=${text%$'\e[201~'}
  printf '%s' "$text"
}

case "${1:-} ${2:-}" in
  "agent list") agents ;;
  "agent focus")
    api session.focus_block "$(jq -cn --arg s "$(session_of "$3")" --arg b "$3" \
      '{session_id: $s, block_id: $b}')" >/dev/null
    ;;
  "pane send-text")
    s=$(session_of "$3")
    rex send -s "$s" -b "$3" "$(unpaste "$4")"
    rex send-key -s "$s" -b "$3" enter
    ;;
  "pane list") printf '{"result":{"panes":[]}}\n' ;;
  "pane rename") : ;;
  "tab list")
    [ "${3:-}" = --workspace ] || { printf 'herdr-shim: tab list needs --workspace\n' >&2; exit 2; }
    api session.view "$(jq -cn --arg s "$4" '{session_id: $s}')" |
      jq -c '{result: {tabs: [.windows[]? | {tab_id: .window_id, label: .label}]}}'
    ;;
  # The reviewr config of the dotfiles: config/rex/reviewr/config.toml.
  "plugin config-dir") printf '%s\n' "$(cd "$here/../reviewr" && pwd)" ;;
  *)
    printf 'herdr-shim: herdr %s is not supported in Rex.\n' "$*" >&2
    exit 1
    ;;
esac
