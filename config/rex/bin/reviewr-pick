#!/usr/bin/env bash
# Pick what ctrl+b d reviews. Print two lines: the git root, and the base (an empty line
# for no base). The record of reviewr-target for BLOCK wins when its folder is still there.
# Else use the folder CWD of the pane. When the record gives no base, the base is the
# commit where the branch left the local default branch, or the upstream on the default
# branch. The branch scope then shows only the work of the branch, not the commits of
# master that are not pushed.
#
#   reviewr-pick BLOCK CWD
set -euo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
block=${1:?usage: reviewr-pick BLOCK CWD}
cwd=${2:?usage: reviewr-pick BLOCK CWD}
record="${XDG_STATE_HOME:-$HOME/.local/state}/rex/reviewr/$block.json"

# root DIR: the git root of DIR, else DIR.
root() {
  git -C "$1" rev-parse --show-toplevel 2>/dev/null || (cd "$1" && pwd -P)
}

# has ROOT NAME: whether ROOT has the local branch NAME or the branch NAME of origin.
has() {
  git -C "$1" rev-parse --verify --quiet "refs/heads/$2" >/dev/null 2>&1 ||
    git -C "$1" rev-parse --verify --quiet "refs/remotes/origin/$2" >/dev/null 2>&1
}

# default_branch ROOT: the default branch that origin/HEAD names, else master or main.
default_branch() {
  local name
  name=$(git -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || name=
  name=${name#origin/}
  if [ -n "$name" ] && has "$1" "$name"; then printf '%s\n' "$name"; return; fi
  for name in master main; do
    if has "$1" "$name"; then printf '%s\n' "$name"; return; fi
  done
  return 1
}

# base ROOT: on the default branch, its upstream. On another branch, the newest commit
# where it left the default branch, local or of origin. Nothing when git cannot tell.
base() {
  local def head ref refs
  def=$(default_branch "$1") || return 0
  head=$(git -C "$1" symbolic-ref --quiet --short HEAD 2>/dev/null) || head=
  if [ "$head" = "$def" ]; then
    git -C "$1" rev-parse --short --verify --quiet '@{upstream}' 2>/dev/null || true
    return 0
  fi
  refs=()
  for ref in "refs/heads/$def" "refs/remotes/origin/$def"; do
    git -C "$1" rev-parse --verify --quiet "$ref" >/dev/null 2>&1 && refs+=("$ref")
  done
  # With two refs, merge-base gives the newest fork point of the two.
  ref=$(git -C "$1" merge-base HEAD ${refs[@]+"${refs[@]}"} 2>/dev/null) || return 0
  git -C "$1" rev-parse --short "$ref" 2>/dev/null || true
}

dir=$cwd
given=
if [ -f "$record" ]; then
  d=$(jq -r '.dir // empty' "$record" 2>/dev/null) || d=
  # The base stays even when dir is the pane folder.
  if [ -n "$d" ] && [ -d "$d" ]; then
    dir=$d
    given=$(jq -r '.base // empty' "$record")
  fi
fi
top=$(root "$dir")
[ -n "$given" ] || given=$(base "$top")
printf '%s\n%s\n' "$top" "$given"
