# The Multica daemon of the agent user of the perso trial (dotfiles multica/README.md).
# multica-agent setup installs it in /etc/systemd/system, multica-agent daemon starts it.
# The login shell gives the daemon the same PATH and git config as "sudo -iu multica-agent".
# Five runs at a time. when-free does not see these runs: no check of CPU or RAM gates them.

[Unit]
Description=Multica daemon of the user multica-agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=multica-agent
Group=multica-agent
WorkingDirectory=~
Environment=MULTICA_DAEMON_MAX_CONCURRENT_TASKS=5
ExecStart=/bin/bash -lc 'exec multica daemon start --foreground'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
