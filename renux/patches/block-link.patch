+/// Renux's own link to a pane: `renux://block/ID`, where ID is a block ID or its end.
+pub const block_prefix = "renux://block/";
+
+/// The block ID of a `renux://block/` link, or null for any other link.
+pub fn blockId(url: []const u8) ?[]const u8 {
+    if (!std.mem.startsWith(u8, url, block_prefix) or url.len == block_prefix.len) return null;
+    return url[block_prefix.len..];
+}
+
 fn notUrl(c: u21) bool {
     return switch (c) {
         ' ', '\t', '<', '>', '"', '\'', '`', '|', '\\', '^', '{', '}', 0 => true,
@@ -144,3 +153,13 @@ test "a link ending at the right edge doesn't swallow the next line" {
     defer cut.deinit(gpa);
     try std.testing.expectEqualStrings("https://a.example/lo", cut.url);
 }
+
+test "a renux block link names a block, not a file" {
+    try std.testing.expectEqualStrings("01a1ef15", blockId("renux://block/01a1ef15").?);
+    try std.testing.expectEqualStrings("block:01a1f42f-1590", blockId("renux://block/block:01a1f42f-1590").?);
+    try std.testing.expect(blockId("renux://block/") == null);
+    try std.testing.expect(blockId("https://example.com/01a1ef15") == null);
+    // An ID of digits only must not read as a file with a line number.
+    const paths = @import("paths.zig");
+    try std.testing.expect((try paths.fromHref(std.testing.allocator, "renux://block/12345678")) == null);
+}
