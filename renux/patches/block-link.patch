+    /// Shows the pane whose block ID ends with `id`, on any host: the target of a
+    /// `renux://block/` link. No such pane: nothing happens.
+    fn jumpBlock(a: *App, id: []const u8) void {
+        if (id.len == 0) return;
+        for (a.hosts.items) |h| for (h.server.sessions.items) |session| {
+            const v = h.server.sessionView(session.id) orelse continue;
+            for (v.windows) |w| for (w.layers) |l| for (l.blocks) |b| {
+                if (!std.mem.endsWith(u8, b.id, id)) continue;
+                // jumpTo can refresh the view that owns these IDs, so keep copies.
+                const sid = gpa.dupe(u8, session.id) catch return;
+                defer gpa.free(sid);
+                const wid = gpa.dupe(u8, w.id) catch return;
+                defer gpa.free(wid);
+                const bid = gpa.dupe(u8, b.id) catch return;
+                defer gpa.free(bid);
+                a.jumpTo(h, sid, wid, bid);
+                a.window.as(gtk.Window).present();
+                return;
+            };
+        };
+    }
