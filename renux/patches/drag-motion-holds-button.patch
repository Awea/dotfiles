+test "a drag motion tells Rex that its button is held" {
+    const t = std.testing.allocator;
+    for ([_][]const u8{ "press", "motion" }) |action| {
+        const held = try std.json.Stringify.valueAlloc(t, Server.heldButtons(action, "left"), .{});
+        defer t.free(held);
+        try std.testing.expectEqualStrings("{\"left\":true}", held);
+    }
+    const released = try std.json.Stringify.valueAlloc(t, Server.heldButtons("release", "left"), .{});
+    defer t.free(released);
+    try std.testing.expectEqualStrings("null", released);
+}
