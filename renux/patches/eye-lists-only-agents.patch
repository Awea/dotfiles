+test "the eye lists agents, and not a program that reports a status" {
+    try std.testing.expect(listsAsAgent("claude", null));
+    try std.testing.expect(listsAsAgent("node/cli.js", "claude"));
+    try std.testing.expect(listsAsAgent("claude", "claude"));
+    try std.testing.expect(!listsAsAgent("leaf", "leaf"));
+    try std.testing.expect(!listsAsAgent("zsh", null));
+}
