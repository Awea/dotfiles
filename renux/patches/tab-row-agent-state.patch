+    /// The pane whose agent state the sidebar row of a tab shows. Null when no pane of the tab
+    /// runs an agent with a state or a sentence. When the tab has more than one agent, the
+    /// most urgent state wins, so the row does not hide an agent that needs you. A finished
+    /// agent that you did not see yet is more urgent than a working agent, as for the eye
+    /// dot. On a tie, the focused pane wins, then the first pane.
+    fn windowAgent(s: *Server, w: *const view.Window) ?[]const u8 {
+        var best: ?[]const u8 = null;
+        var best_rank: u8 = 0;
+        const focused = w.focused_block_id orelse "";
+        for (0..2) |pass| for (w.layers) |l| for (l.blocks) |blk| {
+            // The first pass looks only at the focused pane, the second at the others.
+            if ((pass == 0) != std.mem.eql(u8, blk.id, focused)) continue;
+            if (!blk.isTerminal()) continue;
+            const info = s.blockInfo(blk.id) orelse continue;
+            if (!programs.listsAsAgent(info.program, if (info.has_status) info.status_app else null)) continue;
+            const summary = if (info.summary) |t| t.len > 0 else false;
+            if (!info.has_status and !summary) continue;
+            const status = if (info.has_status) info.status else .other;
+            const rank: u8 = switch (status) {
+                .blocked => 6,
+                .failed => 5,
+                .done => if (info.attention) 4 else 2,
+                .working => 3,
+                .other => 1,
+            };
+            if (rank > best_rank) {
+                best = blk.id;
+                best_rank = rank;
+            }
+        };
+        return best;
+    }
