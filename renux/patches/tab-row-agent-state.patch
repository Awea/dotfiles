+    /// Shows the state of the agent of a tab on its sidebar row, as the eye shows it. When no
+    /// pane of the tab runs an agent, the row shows the tile of its panes.
+    fn fillWindowState(a: *App, mark: *RowMark, h: *Host, w: *const view.Window) void {
+        if (windowAgent(h.server, w)) |block_id| {
+            if (mark.foot) |f| f.setVisible(1);
+            fillState(mark, h, block_id);
+        } else {
+            if (mark.foot) |f| f.setVisible(0);
+            a.updateTile(mark, h.server, w);
+        }
+    }
