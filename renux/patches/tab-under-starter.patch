diff --git a/src/rex/view.zig b/src/rex/view.zig
index 174a7fe..073632c 100644
--- a/src/rex/view.zig
+++ b/src/rex/view.zig
@@ -86,6 +86,35 @@ pub const Window = struct {
     }
 };
 
+/// A tab as the sidebar plans it: the block of the agent that started it (the msg of its
+/// "starter" record, see rex-starter of the dotfiles), the blocks it holds, and whether its
+/// row is on the sidebar (its session is not folded).
+pub const TabRef = struct {
+    starter: ?[]const u8,
+    blocks: []const []const u8,
+    shown: bool,
+};
+
+/// The tab that the tab `i` goes under in the sidebar: the shown tab that holds its starter
+/// block. Null when it has no starter, when no other tab holds that block, when that tab is
+/// not shown, or when that tab goes under a tab itself: one level only.
+pub fn tabParent(tabs: []const TabRef, i: usize) ?usize {
+    const j = holderOf(tabs, i) orelse return null;
+    if (!tabs[j].shown) return null;
+    if (holderOf(tabs, j)) |k| if (tabs[k].shown) return null;
+    return j;
+}
+
+/// The other tab that holds the starter block of the tab `i`.
+fn holderOf(tabs: []const TabRef, i: usize) ?usize {
+    const starter = tabs[i].starter orelse return null;
+    for (tabs, 0..) |t, j| {
+        if (j == i) continue;
+        for (t.blocks) |b| if (std.mem.eql(u8, b, starter)) return j;
+    }
+    return null;
+}
+
 pub const SessionView = struct {
     arena: std.heap.ArenaAllocator,
     revision: i64,
@@ -249,3 +278,29 @@ test "parses a split window" {
     try std.testing.expectEqualStrings("b2", root.split.after.leaf.block_id);
     try std.testing.expectApproxEqAbs(@as(f64, 0.25), root.split.after.rect().x, 1e-9);
 }
+
+test "a tab goes under the tab of its starter" {
+    const a_blocks = [_][]const u8{"a1"};
+    const j_blocks = [_][]const u8{"j1"};
+    const k_blocks = [_][]const u8{"k1"};
+    // A runs the agent, J is its job, K was started from J, S names its own block.
+    const tabs = [_]TabRef{
+        .{ .starter = null, .blocks = &a_blocks, .shown = true },
+        .{ .starter = "a1", .blocks = &j_blocks, .shown = true },
+        .{ .starter = "j1", .blocks = &k_blocks, .shown = true },
+        .{ .starter = "s1", .blocks = &.{"s1"}, .shown = true },
+        .{ .starter = "zz", .blocks = &.{"z1"}, .shown = true },
+    };
+    try std.testing.expectEqual(@as(?usize, 0), tabParent(&tabs, 1));
+    try std.testing.expectEqual(@as(?usize, null), tabParent(&tabs, 0));
+    // One level only: the parent of K has a parent itself.
+    try std.testing.expectEqual(@as(?usize, null), tabParent(&tabs, 2));
+    try std.testing.expectEqual(@as(?usize, null), tabParent(&tabs, 3));
+    try std.testing.expectEqual(@as(?usize, null), tabParent(&tabs, 4));
+    // The tab of the starter is in a folded session: the job stays in its own session.
+    const folded = [_]TabRef{
+        .{ .starter = null, .blocks = &a_blocks, .shown = false },
+        .{ .starter = "a1", .blocks = &j_blocks, .shown = true },
+    };
+    try std.testing.expectEqual(@as(?usize, null), tabParent(&folded, 1));
+}
