diff --git a/src/ui/workspace.zig b/src/ui/workspace.zig
index 0b71402..f2de133 100644
--- a/src/ui/workspace.zig
+++ b/src/ui/workspace.zig
@@ -837,6 +837,25 @@ pub const Workspace = struct {
         return 0;
     }
 
+    /// A single click on the text of a pane title copies the ID of its pane
+    /// (app.pane-copy-id). A click on the empty part of the header only focuses the pane.
+    fn titleClicked(g: *gtk.GestureClick, n_press: c_int, x: f64, _: f64, ws: *Workspace) callconv(.c) void {
+        if (n_press != 1) return;
+        const label = g.as(gtk.EventController).getWidget() orelse return;
+        const text = gobject.ext.cast(gtk.Label, label) orelse return;
+        var text_x: c_int = 0;
+        var text_w: c_int = 0;
+        var text_h: c_int = 0;
+        text.getLayoutOffsets(&text_x, null);
+        text.getLayout().getPixelSize(&text_w, &text_h);
+        if (x < @as(f64, @floatFromInt(text_x)) or x > @as(f64, @floatFromInt(text_x + text_w))) return;
+        const i = ws.paneOfWidget(label.getParent() orelse return) orelse return;
+        const block = gpa.dupeSentinel(u8, ws.panes.items[i].block_id, 0) catch return;
+        defer gpa.free(block);
+        const app = gio.Application.getDefault() orelse return;
+        app.as(gio.ActionGroup).activateAction("pane-copy-id", glib.Variant.newString(block.ptr));
+    }
+
     /// A click on a chip brings its pane back.
     fn chipClicked(button: *gtk.Button, ws: *Workspace) callconv(.c) void {
         if (ws.chip_let_go) return;
@@ -1088,6 +1107,11 @@ pub const Workspace = struct {
         label.as(gtk.Widget).setHexpand(1);
         label.as(gtk.Widget).setMarginStart(6);
         row.append(label.as(gtk.Widget));
+        // A click on the title text copies the pane ID. A drag of the title still moves the pane:
+        // the click gesture stops when the pointer moves.
+        const title_click = gtk.GestureClick.new();
+        _ = gtk.GestureClick.signals.released.connect(title_click, *Workspace, &titleClicked, ws, .{});
+        label.as(gtk.Widget).addController(title_click.as(gtk.EventController));
         const tools = gtk.Box.new(.horizontal, 0);
         tools.as(gtk.Widget).addCssClass("pane-tools");
         var float_button: ?*gtk.Widget = null;
