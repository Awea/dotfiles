@@ -2217,7 +2229,21 @@ pub const TermView = struct {
         if (mods & keys.ctrl == 0 or !v.programHasMouse(mods)) return false;
         const url = v.linkAt(t, cell[0], cell[1]) orelse return false;
         defer gpa.free(url);
-        return keepsClick(url) or v.linksOpenHere();
+        return keepsClick(url) or v.linksOpenHere() or v.keepsWebLink(url);
