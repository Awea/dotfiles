+test "a ctrl+click on a web link is kept from a program on this computer" {
+    // Claude Code waits 500 ms for a double-click before it opens a link itself.
+    try std.testing.expect(TermView.keptWebLink("https://github.com/o/r/pull/46", false));
+    try std.testing.expect(TermView.keptWebLink("HTTP://example.com", false));
+    try std.testing.expect(!TermView.keptWebLink("vscode://file/a.zig", false));
+    try std.testing.expect(!TermView.keptWebLink("mailto:a@example.com", false));
+    try std.testing.expect(!TermView.keptWebLink("https:example.com", false));
+    // A program on a remote host keeps its web links: linksOpenHere decides there.
+    try std.testing.expect(!TermView.keptWebLink("https://example.com", true));
+}
