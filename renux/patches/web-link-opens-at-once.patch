+
+    /// Whether Renux opens a web link that a program on this computer also opens. A program
+    /// such as Claude Code waits for a double-click before it opens a link: Renux opens it
+    /// at once.
+    fn keepsWebLink(v: *const TermView, url: []const u8) bool {
+        return keptWebLink(url, v.onRemoteHost());
+    }
+
+    fn keptWebLink(url: []const u8, remote: bool) bool {
+        if (remote) return false;
+        const colon = std.mem.indexOfScalar(u8, url, ':') orelse return false;
+        if (!std.mem.startsWith(u8, url[colon..], "://")) return false;
+        return std.ascii.eqlIgnoreCase(url[0..colon], "http") or std.ascii.eqlIgnoreCase(url[0..colon], "https");
     }
 
     fn hyperlinkTarget(t: *term_mod.Term, col: u16, row: u16) ?[:0]u8 {
