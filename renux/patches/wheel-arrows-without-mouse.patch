+    pub fn wheelArrows(steps: f64, presses_a_step: u32) struct { name: []const u8, count: u32 } {
+        return .{
+            .name = if (steps < 0) "arrow_up" else "arrow_down",
+            .count = @as(u32, @intFromFloat(@abs(steps))) * presses_a_step,
+        };
+    }
+
+    fn sendWheelArrows(v: *TermView, steps: f64, presses_a_step: u32) void {
+        const arrows = wheelArrows(steps, presses_a_step);
+        var key = keys.Key{ .name = arrows.name };
+        for (0..arrows.count) |_| {
+            key.action = .press;
+            v.server.sendKey(v.session_id, v.block_id, key);
+            key.action = .release;
+            v.server.sendKey(v.session_id, v.block_id, key);
+        }
+    }
