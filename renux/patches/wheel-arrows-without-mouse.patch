+test "the wheel over a full-screen program without the mouse sends arrow keys" {
+    // Rex drops the wheel there, so a pager such as less or man gets nothing.
+    // A wheel notch sends three presses.
+    const up = TermView.wheelArrows(-1, 3);
+    try std.testing.expectEqualStrings("arrow_up", up.name);
+    try std.testing.expectEqual(@as(u32, 3), up.count);
+    const down = TermView.wheelArrows(2, 3);
+    try std.testing.expectEqualStrings("arrow_down", down.name);
+    try std.testing.expectEqual(@as(u32, 6), down.count);
+    // A touchpad already gives rows: one press a row.
+    try std.testing.expectEqual(@as(u32, 2), TermView.wheelArrows(2, 1).count);
+    try std.testing.expectEqual(@as(u32, 0), TermView.wheelArrows(0, 3).count);
+}
