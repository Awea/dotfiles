#!/bin/bash

# macOS: Homebrew installs the packages from the Brewfile, then the programs/
# install scripts run. The Linux only scripts skip themselves.
if [[ "$(uname)" == Darwin ]]; then
  brew bundle --file=Brewfile
  for f in scripts/programs/*; do ./$f; done
  mkdir -p ~/.workspace
  exit 0
fi

# Update Pop!_OS
sudo apt update && sudo apt full-upgrade -y

function install {
  which $1 &> /dev/null

  if [ $? -ne 0 ]; then
    echo "Installing: ${1}..."
    sudo apt install -y $1
  else
    echo "Already installed: ${1}"
  fi
}

# Install basic dependencies
install apache2-utils
install apt-transport-https
install birdtray
install borgbackup
install direnv
install exiftool
install ffmpeg
install flameshot
install git-absorb
install imagemagick
install inotify-tools
install libnotify-bin
install nautilus-dropbox
install network-manager-openvpn-gnome
install parallel
install pv
install software-properties-common
install transmission
install ubuntu-restricted-extras
install wine
install xsel
install zsh

# Run all programs/ install scripts
for f in scripts/programs/*; do ./$f; done

# Create folders
mkdir -p ~/.workspace
