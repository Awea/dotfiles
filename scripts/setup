#!/bin/bash

# macOS: Homebrew installs the packages from the Brewfile, then the programs/
# install scripts run. The Linux only scripts skip themselves.
if [[ "$(uname)" == Darwin ]]; then
  brew bundle --file=Brewfile
  for f in scripts/programs/*; do ./$f; done
  mkdir -p ~/.workspace
  exit 0
fi

# Update Pop!_OS
sudo apt update && sudo apt full-upgrade -y

function install {
  sudo apt install -y "$@"
}

install apache2-utils apt-transport-https birdtray borgbackup exiftool ffmpeg flameshot git-absorb imagemagick inotify-tools libnotify-bin nautilus-dropbox network-manager-openvpn-gnome parallel pv software-properties-common transmission ubuntu-restricted-extras wine xsel zeal zsh jq direnv

# Run all programs/ install scripts
for f in scripts/programs/*; do ./$f; done

# Create folders
mkdir -p ~/.workspace
